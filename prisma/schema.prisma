generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model Agentes {
  id               String             @id @default(dbgenerated("(uuid())")) @db.Char(36)
  name             String             @db.VarChar(150)
  description      String?            @db.Text
  context          String?            @db.Text
  script           String?            @db.Text
  min_score        Int?
  voice            String?            @db.VarChar(100)
  language         String?            @db.VarChar(50)
  interrupt_limit  Int?
  interviewEngine  String?            @default("legacy") @db.VarChar(255)
  humeConfigId     String?            @db.VarChar(255)
  emotionAnalysis  Boolean?           @default(false)
  status           String?            @default("ABIERTA") @db.VarChar(50)
  createdById      String?            @db.VarChar(255)
  createdAt        DateTime?          @default(now()) @db.DateTime(0)
  updatedAt        DateTime?          @default(now()) @db.DateTime(0)
  AgentesCriterios AgentesCriterios[]
  Entrevistas      Entrevistas[]
}

model AgentesCriterios {
  id          String  @id @default(dbgenerated("(uuid())")) @db.Char(36)
  agent_id    String  @db.Char(36)
  name        String  @db.VarChar(150)
  description String? @db.Text
  max_score   Int?    @default(10)
  weight      Int?
  order       Int?
  Agentes     Agentes @relation(fields: [agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "AgentesCriterios_ibfk_1")

  @@index([agent_id], map: "agent_id")
}

