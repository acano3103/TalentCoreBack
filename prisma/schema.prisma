  @@index([idJefeInmediato], map: "FK_Empleados_JefeInmediato")
  @@index([idUsuario], map: "FK_Empleados_Usuarios")
  @@index([idPuesto], map: "FK_Empleados_CatPuestos_idx")
}

model Expedientes {
  idExpediente         Int       @id @default(autoincrement())
  idEmpleado           Int?
  idPuesto             Int?
  idEstatus            Int?
  fechaRegistro        DateTime? @db.Timestamp(0)
  usuarioRegistro      String?   @db.VarChar(250)
  fechaActualizacion   DateTime? @default(now()) @db.Timestamp(0)
  usuarioActualizacion String?   @db.VarChar(250)
}

model RelPuestosUbicaciones {
  idPuestoUbicacion Int        @id @default(autoincrement())
  idPuesto          Int
  idSite            Int
  PlazasAutorizadas Int        @default(0)
  CatPuestos        CatPuestos @relation(fields: [idPuesto], references: [idPuesto], onDelete: Cascade, map: "FK_PuestosUbicaciones_Puestos")
  CatSites          CatSites   @relation(fields: [idSite], references: [idSite], onDelete: Cascade, map: "FK_PuestosUbicaciones_Sites")

  @@unique([idPuesto, idSite], map: "UK_Puesto_Site")
  @@index([idSite], map: "FK_PuestosUbicaciones_Sites")
}

model RelRolPermisos {
  id              Int        @id @default(autoincrement())
  idRol           Int
  idModulo        Int
  puedeVer        Boolean    @default(false)
  puedeCrear      Boolean    @default(false)
  puedeActualizar Boolean    @default(false)
  puedeEliminar   Boolean    @default(false)
  activo          Boolean    @default(true)
  CatModulos      CatModulos @relation(fields: [idModulo], references: [idModulo], onDelete: Cascade, onUpdate: NoAction, map: "fk_permiso_modulo")
  catroles        CatRoles   @relation(fields: [idRol], references: [idRol], onDelete: Cascade, map: "fk_permisos_roles")

  @@unique([idRol, idModulo], map: "idx_rol_modulo_v2")
  @@index([idModulo], map: "fk_permisos_modulos")
}

model Vacantes {
  idVacante                                          Int                  @id @default(autoincrement())
  idUsuarioCreador                                   Int
  idEmpresa                                          Int
  idPuesto                                           Int
  idSite                                             Int
  idJefeInmediato                                    Int
  Motivo                                             String?              @db.Text
  numeroVacantes                                     Int                  @default(1)
  SalarioMinimo                                      Decimal              @db.Decimal(10, 2)
  SalarioMaximo                                      Decimal              @db.Decimal(10, 2)
  InformacionExtra                                   String?              @db.Text
  idEstatusVacante                                   Int                  @default(1)
  idReclutadorAsignado                               Int?
  idTipoPublicacion                                  Int?
  comentarios                                        String?              @db.Text
  fechaCreacion                                      DateTime?            @default(now()) @db.Timestamp(0)
  fechaActualizacion                                 DateTime?            @default(now()) @db.Timestamp(0)
  Entrevistas                                        Entrevistas[]
  Postulaciones                                      Postulaciones[]
  CatEmpresas                                        CatEmpresas          @relation(fields: [idEmpresa], references: [idEmpresa], map: "fk_vacante_empresa")
  CatEstatusVacante                                  CatEstatusVacante    @relation(fields: [idEstatusVacante], references: [idEstatusVacante], map: "fk_vacante_estatus")
  Empleados                                          Empleados            @relation(fields: [idJefeInmediato], references: [idEmpleado], map: "fk_vacante_jefe")
  CatPuestos                                         CatPuestos           @relation(fields: [idPuesto], references: [idPuesto], map: "fk_vacante_puesto")
  Empleados_Vacantes_idReclutadorAsignadoToEmpleados Empleados?           @relation("Vacantes_idReclutadorAsignadoToEmpleados", fields: [idReclutadorAsignado], references: [idEmpleado], onDelete: Restrict, map: "fk_vacante_reclutador")
  CatSites                                           CatSites             @relation(fields: [idSite], references: [idSite], map: "fk_vacante_site")
  CatTiposPublicacion                                CatTiposPublicacion? @relation(fields: [idTipoPublicacion], references: [idTipoPublicacion], onDelete: Restrict, map: "fk_vacante_tipo_pub")
  auth_user                                          auth_user            @relation(fields: [idUsuarioCreador], references: [id], map: "fk_vacante_usuario_creador")

  @@index([idJefeInmediato], map: "fk_vacante_jefe")
  @@index([idPuesto], map: "fk_vacante_puesto")
  @@index([idSite], map: "fk_vacante_site")
  @@index([idEmpresa], map: "fk_vacante_empresa")
  @@index([idEstatusVacante], map: "fk_vacante_estatus")
  @@index([idReclutadorAsignado], map: "fk_vacante_reclutador")
  @@index([idTipoPublicacion], map: "fk_vacante_tipo_pub")
  @@index([idUsuarioCreador], map: "fk_vacante_usuario_creador")
}

model CatEstatusPostulacion {
  idEstatusPostulacion Int     @id @default(autoincrement())
  descripcion          String  @db.VarChar(45)
  activo               Boolean @default(true)
}

model CatTiposPublicacion {
  idTipoPublicacion Int        @id @default(autoincrement())
  descripcion       String     @db.VarChar(50)
  activo            Boolean    @default(true)
  Vacantes          Vacantes[]
}

model CatRoles {
  idRol          Int              @id @default(autoincrement())
  descripcion    String           @db.VarChar(100)
  activo         Boolean          @default(true)
  RelRolPermisos RelRolPermisos[]
}

model RelUsuarioRol {
  iRel      Int     @id @default(autoincrement())
  idUsuario Int
  idRol     Int
  activo    Boolean @default(true)
}

model CatEstatusSolicitudPuesto {
  id              Int               @id @default(autoincrement())
  descripcion     String            @db.VarChar(50)
  activo          Boolean?          @default(true)
  fecha_creacion  DateTime?         @default(now()) @db.Timestamp(0)
  SolicitudPuesto SolicitudPuesto[]
}

model SolicitudPuesto {
  id                        Int                        @id @default(autoincrement())
  idEmpresa                 Int
  idUsuarioSolicita         Int
  descripcion               String                     @db.Text
  estatusId                 Int?                       @default(1)
  comentarios               String?                    @db.Text
  fechaCreacion             DateTime?                  @default(now()) @db.Timestamp(0)
  fechaActualizacion        DateTime?                  @default(now()) @db.Timestamp(0)
  CatEstatusSolicitudPuesto CatEstatusSolicitudPuesto? @relation(fields: [estatusId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_solicitud_estatus")
  auth_user                 auth_user                  @relation(fields: [idUsuarioSolicita], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_solicitud_usuario")

  @@index([estatusId], map: "fk_solicitud_estatus")
  @@index([idEmpresa, estatusId], map: "idx_empresa_estatus")
  @@index([fechaCreacion], map: "idx_fecha")
  @@index([idUsuarioSolicita], map: "fk_solicitud_usuario")
}

model HistoricoMovimientos {
  id            Int       @id @default(autoincrement())
  idUsuario     Int
  idEmpresa     Int
  accion        String    @db.VarChar(50)
  tablaOrigen   String    @db.VarChar(100)
  idRegistro    Int
  descripcion   String    @db.Text
  detalles_json Json?
  fechaCreacion DateTime? @default(now()) @db.Timestamp(0)
  auth_user     auth_user @relation(fields: [idUsuario], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_historico_usuario")

  @@index([fechaCreacion], map: "idx_creado_at")
  @@index([tablaOrigen, idRegistro], map: "idx_polimorfico")
  @@index([idUsuario], map: "idx_usuario")
}

enum Entrevistas_interview_type {
  PERSONA
  IA
}

enum Entrevistas_modality {
  ONLINE
  PRESENCIAL
}
