# Comunicación interna
# Carpeta local de portadas y adjuntos. CommsStorageService la usa; la interfaz queda lista para S3.
COMMS_MEDIA_BASE_PATH=comms-media
# URL pública del API, sin barra final (por ejemplo https://api.ejemplo.com).
# En producción debe estar definida: url y portadaUrl de portadas y adjuntos salen absolutas.
# Si queda vacía, el arranque advierte en el log y los clientes usan ruta / portadaRuta,
# relativas a api/v2 (public/comms/files/:firma).
# También es el origen del enlace seguro que se envía por correo o WhatsApp.
COMMS_PUBLIC_BASE_URL=
# Opcional. Token de Expo Push API. Sin él el envío push no se habilita.
EXPO_ACCESS_TOKEN=
# Opcional. Secreto del webhook de estados de Gupshup. Sin él el callback responde 503.
# No uses GUPSHUP_API_KEY aquí: es otra credencial.
GUPSHUP_WEBHOOK_SECRET=
# Cola de envío (Bull). Sin esta variable el API usa redis://127.0.0.1:6379.
# Si Redis no responde, POST …/send responde 503 y el comunicado queda pendiente de reencolar.
REDIS_URL=redis://127.0.0.1:6379
